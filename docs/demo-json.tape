Output "/tmp/truthroute-demo/docs/demo-json.gif"
Set FontSize 16
Set Width 760
Set Height 260
Set Theme "Dracula"
Set WindowBar Colorful
Set WindowBarSize 36

Type "export PS1='$ '"
Enter
Sleep 300ms

Type `truthroute compare "What year did the Berlin Wall fall?" --models openai,anthropic --json --dry-run`
Enter
Sleep 3s
