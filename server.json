{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.RudrenduPaul/truthroute",
  "description": "Sends the same prompt to multiple LLM providers in parallel and returns a divergence score via MCP.",
  "repository": {
    "url": "https://github.com/RudrenduPaul/TruthRoute",
    "source": "github"
  },
  "version": "0.1.4",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "truthroute-cli",
      "version": "0.1.4",
      "runtimeHint": "npx",
      "packageArguments": [
        {
          "type": "positional",
          "valueHint": "subcommand",
          "value": "mcp"
        }
      ],
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
